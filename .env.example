NEXT_PUBLIC_SITE_URL=https://www.kabukibd.com
CONTACT_WEBHOOK_URL=
CONTACT_FROM_EMAIL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Admin login password (defaults to "kabuki-admin" when unset)
ADMIN_PASSWORD=
ADMIN_SECRET=

# Vercel Blob — required in production so CMS saves and image uploads persist.
# Auto-injected by Vercel when you connect a Blob store to the project.
# Without it the CMS falls back to the local data/cms.json + public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=
